# JWT_SECRET: Secret key for signing JWT tokens (keep this secure in production)
JWT_SECRET="your-production-jwt-secret-key-change-this-in-production"

# PORT: Port number for the server to listen on
PORT=3000

# DATABASE_PATH: Path to the SQLite database file
DATABASE_PATH="./database.sqlite"

# APP_URL: The base URL of your application (used for CORS and links)
APP_URL="http://localhost:3000"